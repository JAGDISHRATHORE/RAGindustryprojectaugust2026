# Copy to .env and adjust. Every setting in complyrag/config.py can be set here.

# --- LLM: any OpenAI-compatible endpoint ---------------------------------
# Local Ollama (default, documents never leave the machine)
COMPLYRAG_LLM_BASE_URL=http://localhost:11434/v1
COMPLYRAG_LLM_API_KEY=ollama
COMPLYRAG_LLM_MODEL=qwen2.5:7b-instruct

# OpenAI
# COMPLYRAG_LLM_BASE_URL=https://api.openai.com/v1
# COMPLYRAG_LLM_API_KEY=sk-...
# COMPLYRAG_LLM_MODEL=gpt-4o-mini
# COMPLYRAG_LLM_PRICE_IN_PER_1K=0.00014
# COMPLYRAG_LLM_PRICE_OUT_PER_1K=0.00055

# Azure OpenAI (v1 API, EU data zone)
# COMPLYRAG_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# COMPLYRAG_LLM_API_KEY=<key>
# COMPLYRAG_LLM_MODEL=<deployment name>

# --- retrieval -------------------------------------------------------------
COMPLYRAG_EMBEDDING_BACKEND=fastembed
COMPLYRAG_RERANKER_BACKEND=cross-encoder
COMPLYRAG_JUDGE_BACKEND=llm

# Fully offline mode (no model downloads, no LLM)
# COMPLYRAG_EMBEDDING_BACKEND=lsa
# COMPLYRAG_RERANKER_BACKEND=none
# COMPLYRAG_JUDGE_BACKEND=rules

# --- ops -------------------------------------------------------------------
# COMPLYRAG_API_KEY=change-me
# COMPLYRAG_OTEL_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
